<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.gabrieltorland.headphone-battery</string>

  <!-- Reading the battery has to happen here rather than from a sketchybar
       script: Bluetooth is not available to processes sketchybar spawns, which
       fail silently, while a launchd agent is granted it normally. The agent
       writes the reading to a file and the widget only ever reads that file. -->
  <!-- It stays running rather than being woken on a timer because the reading
       changes the moment you switch what you are listening through, and macOS
       says so immediately. Waiting out an interval to notice would mean the bar
       is wrong for minutes at a time. --notify nudges sketchybar, but only when
       the reading actually changed. -->
  <key>ProgramArguments</key>
  <array>
    <string>__PREFIX__/bin/headphone-battery</string>
    <string>--watch</string>
    <string>--json</string>
    <string>--output</string>
    <string>__CACHE__</string>
    <string>--notify</string>
    <string>__SKETCHYBAR__ --trigger headphone_battery_change</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restarted if it ever stops, including the deliberate exit on a Bluetooth
       call that hangs, which is the one failure it cannot recover from itself. -->
  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
