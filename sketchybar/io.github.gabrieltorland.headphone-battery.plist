<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.gabrieltorland.headphone-battery</string>

  <!-- Reading the battery has to happen here rather than from a sketchybar
       script: Bluetooth is not available to processes sketchybar spawns, which
       fail silently, while a launchd agent is granted it normally. The agent
       writes the reading to a file and the widget only ever reads that file. -->
  <key>ProgramArguments</key>
  <array>
    <string>__PREFIX__/bin/headphone-battery</string>
    <string>--json</string>
    <string>--output</string>
    <string>__CACHE__</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
